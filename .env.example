# Copie este arquivo para .env.local e preencha com as chaves do seu
# projeto Supabase (Project Settings → API no app.supabase.com).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só necessária para o script de seed de prestadores demo
# (scripts/seed-demo.ts). NUNCA exponha isso com o prefixo NEXT_PUBLIC_
# nem coloque no navegador — só é usada em Node, do lado do servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Região ativa do MVP (item 5 da spec). Por enquanto só Jandira-SP.
NEXT_PUBLIC_APP_CITY=Jandira
NEXT_PUBLIC_APP_STATE=SP
NEXT_PUBLIC_APP_COUNTRY=BR

# Reservado para quando o Google Maps entrar (não usado por ora — a
# localização hoje é resolvida só com os bairros cadastrados no banco).
GOOGLE_MAPS_API_KEY=
